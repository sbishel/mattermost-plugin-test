{
    "id": "com.mattermost.test-plugin",
    "name": "Test Plugin",
    "description": "This plugin serves as a test plugin for e2e tests.",
    "homepage_url": "https://github.com/mattermost/mattermost-plugin-test",
    "support_url": "https://github.com/mattermost/mattermost-plugin-test/issues",
    "icon_path": "assets/starter-template-icon.svg",
    "min_server_version": "6.2.1",
    "server": {
        "executables": {
            "linux-amd64": "server/dist/plugin-linux-amd64",
            "linux-arm64": "server/dist/plugin-linux-arm64",
            "darwin-amd64": "server/dist/plugin-darwin-amd64",
            "darwin-arm64": "server/dist/plugin-darwin-arm64",
            "windows-amd64": "server/dist/plugin-windows-amd64.exe"
        }
    },
    "webapp": {
        "bundle_path": "webapp/dist/main.js"
    },
    "settings_schema": {
        "header": "",
        "footer": "",
        "settings": [
            {
                "key": "EnableDialogCommands",
                "display_name": "Enable Dialog Commands",
                "type": "bool",
                "help_text": "Enable the /e2e-dialog slash command and dialog submission handlers.",
                "default": true
            }
        ]
    }
}
